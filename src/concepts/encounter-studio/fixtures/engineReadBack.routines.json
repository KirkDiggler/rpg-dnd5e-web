          "title": "Routine `captain-policy`",
          "about": {
            "kind": "routine",
            "id": "captain-policy"
          },
          "statements": [
            {
              "kind": "routine",
              "about": {
                "kind": "routine",
                "id": "captain-policy"
              },
              "sentence": "The routine `captain-policy` is run by Guard Captain (captain); it starts in the state `ready`; its recipe is `site:behaviors:captain-policy`. When it acts from a set of rows, one row whose conditions hold is picked by weight.",
              "path": "behaviorDefinitions.captain-policy",
              "connects": [
                {
                  "kind": "creature",
                  "id": "captain",
                  "role": "runs"
                }
              ]
            },
            {
              "kind": "routine.state",
              "about": {
                "kind": "routine",
                "id": "captain-policy"
              },
              "sentence": "In the state `ready`, Guard Captain (captain) listens for 7 beats.",
              "path": "behaviorDefinitions.captain-policy.recipe.states.ready"
            },
            {
              "kind": "routine.wake",
              "about": {
                "kind": "routine",
                "id": "captain-policy"
              },
              "sentence": "In the state `ready`, when Guard Captain (captain) learns a fact, if Guard Captain (captain) knows the fact `guards-turned`, Guard Captain (captain) moves to the state `turned` (“the garrison turned”); the change and its reason reach every member of the run, wherever they are, whether or not they saw or heard what caused it.",
              "path": "behaviorDefinitions.captain-policy.recipe.states.ready.transitions[0]",
              "connects": [
                {
                  "kind": "fact",
                  "id": "guards-turned",
                  "role": "wakes-on"
                }
              ]
            }
          ]
        },
